@startuml UCD_01_NeighborCare

left to right direction
skinparam monochrome true
skinparam shadowing false
skinparam packageStyle folder

actor Utente as ut
actor Beneficiario as b
actor Coordinatore as c
actor Neighbor as nb

package "NeighborCare" {
    folder "Gestione\nUtente" as GU
    folder "Gestione\nBeneficiario" as GB
    folder "Gestione\nCoordinatore" as GC
    folder "Gestione\nNeighbor" as GN
}

ut -- GU
b -- GB
c -- GC
nb -- GN

@enduml